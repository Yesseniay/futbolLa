<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainperu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030B38"
    tools:context=".MainActivityjugadoreschiclayo">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="390dp"
        android:layout_height="578dp"
        app:srcCompat="@drawable/juadorchiclayo"
        tools:layout_editor_absoluteX="10dp"
        tools:layout_editor_absoluteY="16dp" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="390dp"
        android:layout_height="787dp"
        app:srcCompat="@drawable/jugadorchiclayo2"
        tools:layout_editor_absoluteX="10dp"
        tools:layout_editor_absoluteY="269dp" />

    <ScrollView
        android:layout_width="10dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <ScrollView
        android:layout_width="391dp"
        android:layout_height="423dp"
        tools:layout_editor_absoluteX="14dp"
        tools:layout_editor_absoluteY="636dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <ImageButton
        android:id="@+id/volverButton"
        android:layout_width="72dp"
        android:layout_height="54dp"
        app:srcCompat="@android:drawable/ic_menu_revert"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="13dp" />

</androidx.constraintlayout.widget.ConstraintLayout>