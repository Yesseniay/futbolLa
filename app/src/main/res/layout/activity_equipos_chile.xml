<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA020A3F"
    tools:context=".equipos_chile">

    <!-- Titulo -->

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Equipos de Chile"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botones fila 1 -->

    <ImageButton
        android:id="@+id/btn_colo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:srcCompat="@drawable/colo_colo" />

    <ImageButton
        android:id="@+id/btn_u.chile"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toEndOf="@id/btn_colo"
        app:layout_constraintTop_toTopOf="@id/btn_colo"
        app:srcCompat="@drawable/u" />

    <ImageButton
        android:id="@+id/btn_iquique"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toEndOf="@id/btn_u.chile"
        app:layout_constraintTop_toTopOf="@id/btn_u.chile"
        app:srcCompat="@drawable/iquique" />

    <!-- Botones fila 2 -->

    <ImageButton
        android:id="@+id/btn_catolica"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="@id/btn_colo"
        app:layout_constraintTop_toBottomOf="@id/btn_colo"
        app:srcCompat="@drawable/catolica" />

    <ImageButton
        android:id="@+id/btn_cobresal"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toEndOf="@id/btn_catolica"
        app:layout_constraintTop_toTopOf="@id/btn_catolica"
        app:srcCompat="@drawable/cobresal" />

    <ImageButton
        android:id="@+id/btn_palestino"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toEndOf="@id/btn_cobresal"
        app:layout_constraintTop_toTopOf="@id/btn_cobresal"
        app:srcCompat="@drawable/palestino" />

    <!-- Botones fila 3 -->

    <ImageButton
        android:id="@+id/btn_huachipato"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="@id/btn_catolica"
        app:layout_constraintTop_toBottomOf="@id/btn_catolica"
        app:srcCompat="@drawable/huachipato" />

    <ImageButton
        android:id="@+id/btn_nublense"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toEndOf="@id/btn_huachipato"
        app:layout_constraintTop_toTopOf="@id/btn_huachipato"
        app:srcCompat="@drawable/_ublense" />

    <ImageButton
        android:id="@+id/btn_coquimbo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginStart="16dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toEndOf="@id/btn_nublense"
        app:layout_constraintTop_toTopOf="@id/btn_nublense"
        app:srcCompat="@drawable/coquimbo" />

</androidx.constraintlayout.widget.ConstraintLayout>